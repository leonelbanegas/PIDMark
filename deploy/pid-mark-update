#!/usr/bin/env bash
set -Eeuo pipefail

readonly APP_DIR="/opt/pid-mark"
readonly DATA_DIR="/var/lib/pid-mark"
readonly CONFIG_FILE="/etc/pid-mark/config.ini"
readonly SERVICE="pid-mark"
readonly HEALTH_URL="http://127.0.0.1:4123/api/sesion"
readonly ARCHIVE_BASE_URL="https://codeload.github.com/leonelbanegas/PIDMark/tar.gz"

WORK_DIR=""
BACKUP_DIR=""
TRANSACTION_STARTED=0

usage() {
  echo "Uso: sudo pid-mark-update <version|tag> [commit-sha]"
  echo "Ejemplo: sudo pid-mark-update v1.1.1"
}

rollback_on_error() {
  local status=$?
  trap - EXIT

  if (( TRANSACTION_STARTED )); then
    echo "La actualización falló; restaurando la versión anterior..." >&2
    if ! systemctl stop "$SERVICE"; then
      echo "No se pudo detener el servicio durante el rollback." >&2
    fi
    if [[ -e "$APP_DIR" ]]; then
      local failed_dir="/opt/pid-mark-failed-$(date +%Y%m%d-%H%M%S)"
      if mv -- "$APP_DIR" "$failed_dir"; then
        echo "Código fallido conservado en: $failed_dir" >&2
      else
        echo "No se pudo apartar el código fallido en $APP_DIR." >&2
      fi
    fi
    if [[ -n "$BACKUP_DIR" && -d "$BACKUP_DIR" ]]; then
      if mv -- "$BACKUP_DIR" "$APP_DIR"; then
        if systemctl start "$SERVICE"; then
          echo "Versión anterior restaurada desde: $BACKUP_DIR" >&2
        else
          echo "El código anterior fue restaurado, pero no se pudo iniciar el servicio." >&2
        fi
      else
        echo "No se pudo restaurar el código anterior desde: $BACKUP_DIR" >&2
      fi
    else
      echo "No se encontró el respaldo para rollback: $BACKUP_DIR" >&2
    fi
  fi

  if [[ -n "$WORK_DIR" && -d "$WORK_DIR" ]]; then
    rm -rf -- "$WORK_DIR"
  fi
  exit "$status"
}

if (( EUID != 0 )); then
  echo "Ejecuta este comando con sudo." >&2
  exit 1
fi

if (( $# < 1 || $# > 2 )); then
  usage >&2
  exit 2
fi

requested_tag="$1"
requested_tag="${requested_tag#v}"
if [[ ! "$requested_tag" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
  echo "Versión inválida. Usa un formato como 1.0.1 o v1.0.1." >&2
  exit 2
fi
readonly TAG="v${requested_tag}"
commit_sha="${2:-}"
if [[ -n "$commit_sha" && ! "$commit_sha" =~ ^[0-9a-fA-F]{40}$ ]]; then
  echo "El commit debe ser un SHA hexadecimal de 40 caracteres." >&2
  exit 2
fi
archive_ref="refs/tags/${TAG}"
if [[ -n "$commit_sha" ]]; then
  archive_ref="$commit_sha"
fi

for command in curl install tar node npm runuser systemctl systemd-tmpfiles visudo; do
  if ! command -v "$command" >/dev/null 2>&1; then
    echo "Falta el comando requerido: $command" >&2
    exit 1
  fi
done

if ! id pidmark >/dev/null 2>&1; then
  echo "No existe el usuario de servicio pidmark." >&2
  exit 1
fi
if [[ ! -f "$APP_DIR/package.json" || ! -f "$APP_DIR/server.js" ]]; then
  echo "No se encontró una instalación PID Mark en $APP_DIR." >&2
  exit 1
fi
if [[ ! -f "$CONFIG_FILE" || ! -d "$DATA_DIR" ]]; then
  echo "No se encuentra la configuración o los datos persistentes de PID Mark." >&2
  exit 1
fi
if [[ ! -f "/etc/systemd/system/${SERVICE}.service" ]]; then
  echo "No se encontró /etc/systemd/system/${SERVICE}.service." >&2
  exit 1
fi
if ! systemctl is-active --quiet "$SERVICE"; then
  echo "El servicio $SERVICE debe estar activo antes de actualizar." >&2
  exit 1
fi

if ! node -e 'const [major, minor] = process.versions.node.split(".").map(Number); process.exit(major > 22 || (major === 22 && minor >= 13) ? 0 : 1)'; then
  echo "PID Mark requiere Node.js 22.13.0 o posterior." >&2
  exit 1
fi

current_version="$(node -p "require('${APP_DIR}/package.json').version")"
if [[ "$current_version" == "$requested_tag" ]]; then
  echo "PID Mark ya está en la versión $TAG."
  exit 0
fi

WORK_DIR="$(mktemp -d /opt/.pid-mark-update.XXXXXX)"
chown pidmark:pidmark "$WORK_DIR"
readonly NEW_DIR="${WORK_DIR}/app"
readonly ARCHIVE="${WORK_DIR}/source.tar.gz"
mkdir "$NEW_DIR"
chown pidmark:pidmark "$NEW_DIR"

echo "Descargando PID Mark $TAG desde GitHub..."
curl --fail --location --silent --show-error \
  "${ARCHIVE_BASE_URL}/${archive_ref}" \
  --output "$ARCHIVE"
tar -xzf "$ARCHIVE" --strip-components=1 -C "$NEW_DIR"

new_version="$(node -p "require('${NEW_DIR}/package.json').version")"
if [[ "$new_version" != "$requested_tag" ]]; then
  echo "La etiqueta $TAG contiene la versión $new_version; se esperaba $requested_tag." >&2
  exit 1
fi
if [[ ! -f "${NEW_DIR}/server.js" || ! -f "${NEW_DIR}/package-lock.json" || ! -f "${NEW_DIR}/deploy/pid-mark.service" || ! -f "${NEW_DIR}/deploy/pid-mark-console-banner" || ! -f "${NEW_DIR}/deploy/pid-mark-console-banner.conf" || ! -f "${NEW_DIR}/deploy/pid-mark-web-update.js" || ! -f "${NEW_DIR}/deploy/pid-mark-web-update.service" || ! -f "${NEW_DIR}/deploy/pid-mark-web-update.sudoers" || ! -f "${NEW_DIR}/deploy/pid-mark-web-update.tmpfiles" ]]; then
  echo "La etiqueta descargada no contiene los archivos requeridos." >&2
  exit 1
fi

chown -R pidmark:pidmark "$NEW_DIR"
echo "Instalando dependencias de producción..."
runuser -u pidmark -- env HOME="$DATA_DIR" npm --prefix "$NEW_DIR" ci --omit=dev --no-audit --no-fund
chown -R root:pidmark "$NEW_DIR"

BACKUP_DIR="/opt/pid-mark-backup-${current_version}-$(date +%Y%m%d-%H%M%S)"
if [[ -e "$BACKUP_DIR" ]]; then
  echo "La ruta de respaldo ya existe: $BACKUP_DIR" >&2
  exit 1
fi

install -o root -g root -m 0644 \
  "${NEW_DIR}/deploy/pid-mark-web-update.tmpfiles" \
  /etc/tmpfiles.d/pid-mark-web-update.conf
systemd-tmpfiles --create /etc/tmpfiles.d/pid-mark-web-update.conf
install -o root -g root -m 0644 \
  "${NEW_DIR}/deploy/pid-mark.service" "/etc/systemd/system/${SERVICE}.service"
systemctl daemon-reload

trap rollback_on_error EXIT
echo "Deteniendo PID Mark..."
systemctl stop "$SERVICE"
mv -- "$APP_DIR" "$BACKUP_DIR"
TRANSACTION_STARTED=1
mv -- "$NEW_DIR" "$APP_DIR"

echo "Iniciando PID Mark $TAG..."
systemctl start "$SERVICE"

healthy=0
for _ in {1..30}; do
  if response="$(curl --fail --silent --show-error --max-time 2 \
    --user-agent 'Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36' \
    "$HEALTH_URL" 2>/dev/null)" \
    && [[ "$response" == *"\"version\":\"${requested_tag}\""* ]]; then
    healthy=1
    break
  fi
  sleep 1
done

if (( ! healthy )); then
  echo "PID Mark no confirmó la versión $requested_tag en ${HEALTH_URL}." >&2
  exit 1
fi

install -o root -g root -m 0755 \
  "${APP_DIR}/deploy/pid-mark-update" /usr/local/sbin/pid-mark-update
install -o root -g root -m 0755 \
  "${APP_DIR}/deploy/pid-mark-web-update.js" /usr/local/sbin/pid-mark-web-update.js
install -o root -g root -m 0644 \
  "${APP_DIR}/deploy/pid-mark-web-update.service" \
  /etc/systemd/system/pid-mark-web-update.service
sudoers_tmp="$(mktemp /etc/sudoers.d/.pid-mark-web-update.XXXXXX)"
install -o root -g root -m 0440 \
  "${APP_DIR}/deploy/pid-mark-web-update.sudoers" "$sudoers_tmp"
if ! visudo -cf "$sudoers_tmp"; then
  rm -f -- "$sudoers_tmp"
  echo "La regla sudoers para la actualización web no pasó la validación." >&2
  exit 1
fi
install -o root -g root -m 0440 \
  "$sudoers_tmp" /etc/sudoers.d/pid-mark-web-update
rm -f -- "$sudoers_tmp"
systemctl daemon-reload
install -o root -g root -m 0755 \
  "${APP_DIR}/deploy/pid-mark-console-banner" \
  /usr/local/sbin/pid-mark-console-banner
install -d -o root -g root -m 0755 \
  /etc/systemd/system/getty@tty1.service.d
install -o root -g root -m 0644 \
  "${APP_DIR}/deploy/pid-mark-console-banner.conf" \
  /etc/systemd/system/getty@tty1.service.d/50-pid-mark-console-banner.conf
systemctl daemon-reload
/usr/local/sbin/pid-mark-console-banner

TRANSACTION_STARTED=0
trap - EXIT
rm -rf -- "$WORK_DIR"
WORK_DIR=""

echo "Actualización completada: PID Mark $TAG."
echo "Versión anterior conservada en: $BACKUP_DIR"
